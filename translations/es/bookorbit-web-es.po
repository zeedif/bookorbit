msgstr "Comprobación de importación activada"

#: client/src/locales/en.json:4248
#: client/src/features/settings/RequestAutomationPanel.vue:285
#. Clave de Crowdin: settings.system.requests.automation.verificationDisabled
#. Área: settings > system > requests > automation
#. Conservar los parámetros y los nombres propios.
msgctxt "settings.system.requests.automation.verificationDisabled"
msgid "Import checking is off. Downloads will be filed without review"
msgstr "Comprobación de importación desactivada. Las descargas se archivarán sin revisión"

#: client/src/locales/en.json:4249
#: client/src/features/settings/RequestAutomationPanel.vue:516
#. Clave de Crowdin: settings.system.requests.automation.verification
